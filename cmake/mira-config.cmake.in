@PACKAGE_INIT@

# Explicit components load only their dependency closure; no components loads all installed modules.
set(MIRA_WITH_TLS @MIRA_ENABLE_TLS@)
set(MIRA_WITH_HTTP2 @MIRA_ENABLE_HTTP2@)
set(MIRA_WITH_HTTP3 @MIRA_ENABLE_HTTP3@)
set(MIRA_WITH_WS @MIRA_ENABLE_WEBSOCKET@)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/miraTargets.cmake")
set(Mira_core_FOUND TRUE)
set(Mira_http_common_FOUND TRUE)
set(Mira_transport_FOUND TRUE)
set(Mira_http_FOUND TRUE)
set(Mira_socks_FOUND TRUE)
set(Mira_dns_FOUND TRUE)
set(Mira_mqtt_FOUND TRUE)
set(Mira_client_FOUND TRUE)
set(Mira_client_tls_FOUND FALSE)
set(Mira_client_http2_FOUND FALSE)
set(Mira_client_http3_FOUND FALSE)
set(Mira_tls_FOUND FALSE)
set(Mira_crypto_FOUND FALSE)
set(Mira_ws_FOUND FALSE)
set(Mira_http2_FOUND FALSE)
set(Mira_quic_FOUND FALSE)
set(Mira_http3_FOUND FALSE)
set(Mira_FOUND TRUE)
unset(Mira_NOT_FOUND_MESSAGE)

set(_mira_components ${Mira_FIND_COMPONENTS})
if(NOT _mira_components)
    foreach(_component IN ITEMS tls ws http2 http3)
        string(TOUPPER "${_component}" _option)
        if(MIRA_WITH_${_option})
            list(APPEND _mira_components ${_component})
        endif()
    endforeach()
    if(MIRA_WITH_TLS)
        list(APPEND _mira_components client_tls)
        if(MIRA_WITH_HTTP2)
            list(APPEND _mira_components client_http2)
        endif()
    endif()
    if(MIRA_WITH_HTTP3)
        list(APPEND _mira_components client_http3)
    endif()
endif()

if("client_http2" IN_LIST _mira_components)
    list(APPEND _mira_components http2 tls)
endif()
if("client_http3" IN_LIST _mira_components)
    list(APPEND _mira_components http3)
endif()

# Probe quietly first so missing OPTIONAL_COMPONENTS dependencies do not fail the package.
if(("tls" IN_LIST _mira_components OR "client_tls" IN_LIST _mira_components) AND MIRA_WITH_TLS)
    find_package(OpenSSL 3.0 QUIET COMPONENTS SSL Crypto)
    if(OpenSSL_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/miraTlsTargets.cmake")
        set(Mira_tls_FOUND TRUE)
        if("client_tls" IN_LIST _mira_components)
            include("${CMAKE_CURRENT_LIST_DIR}/miraClientTlsTargets.cmake")
            set(Mira_client_tls_FOUND TRUE)
        endif()
    endif()
endif()
if(("crypto" IN_LIST _mira_components OR "ws" IN_LIST _mira_components) AND MIRA_WITH_WS)
    find_package(OpenSSL 3.0 QUIET COMPONENTS Crypto)
    if(OpenSSL_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/miraCryptoTargets.cmake")
        set(Mira_crypto_FOUND TRUE)
        if("ws" IN_LIST _mira_components)
            find_package(ZLIB QUIET)
            if(ZLIB_FOUND)
                if(APPLE AND IS_DIRECTORY "${CMAKE_OSX_SYSROOT}")
                    file(REAL_PATH "${CMAKE_OSX_SYSROOT}/usr/include" _mira_sdk_include)
                    get_target_property(_mira_zlib_includes ZLIB::ZLIB INTERFACE_INCLUDE_DIRECTORIES)
                    set(_mira_zlib_filtered "")
                    foreach(_include IN LISTS _mira_zlib_includes)
                        if(IS_DIRECTORY "${_include}")
                            file(REAL_PATH "${_include}" _real_include)
                        else()
                            set(_real_include "${_include}")
                        endif()
                        if(NOT _real_include STREQUAL _mira_sdk_include)
                            list(APPEND _mira_zlib_filtered "${_include}")
                        endif()
                    endforeach()
                    set_property(TARGET ZLIB::ZLIB PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_mira_zlib_filtered}")
                    unset(_mira_zlib_includes)
                    unset(_mira_zlib_filtered)
                    unset(_mira_sdk_include)
                    unset(_include)
                    unset(_real_include)
                endif()
                include("${CMAKE_CURRENT_LIST_DIR}/miraWsTargets.cmake")
                set(Mira_ws_FOUND TRUE)
            endif()
        endif()
    endif()
endif()
if("http2" IN_LIST _mira_components AND MIRA_WITH_HTTP2)
    set(_mira_saved_module_path "${CMAKE_MODULE_PATH}")
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_package(NGHTTP2 1.61 QUIET)
    set(CMAKE_MODULE_PATH "${_mira_saved_module_path}")
    unset(_mira_saved_module_path)
    if(NGHTTP2_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/miraHttp2Targets.cmake")
        set(Mira_http2_FOUND TRUE)
    endif()
endif()
if(("quic" IN_LIST _mira_components OR "http3" IN_LIST _mira_components)
        AND MIRA_WITH_HTTP3)
    find_package(OpenSSL 3.5 QUIET COMPONENTS SSL Crypto)
    find_path(MIRA_NGTCP2_INCLUDE_DIR ngtcp2/ngtcp2_crypto_ossl.h)
    find_library(MIRA_NGTCP2_LIBRARY NAMES ngtcp2 ngtcp2_static NAMES_PER_DIR)
    find_library(MIRA_NGTCP2_OSSL_LIBRARY NAMES ngtcp2_crypto_ossl ngtcp2_crypto_ossl_static NAMES_PER_DIR)
    if(OpenSSL_FOUND AND MIRA_NGTCP2_INCLUDE_DIR AND MIRA_NGTCP2_LIBRARY
            AND MIRA_NGTCP2_OSSL_LIBRARY)
        include("${CMAKE_CURRENT_LIST_DIR}/mira-quic-dependencies.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/miraQuicTargets.cmake")
        set(Mira_quic_FOUND TRUE)
    endif()
endif()
if("http3" IN_LIST _mira_components AND Mira_quic_FOUND)
    find_path(MIRA_NGHTTP3_INCLUDE_DIR nghttp3/nghttp3.h)
    find_library(MIRA_NGHTTP3_LIBRARY NAMES nghttp3 nghttp3_static NAMES_PER_DIR)
    set(_mira_nghttp3_version "")
    if(MIRA_NGHTTP3_INCLUDE_DIR AND EXISTS "${MIRA_NGHTTP3_INCLUDE_DIR}/nghttp3/version.h")
        file(STRINGS "${MIRA_NGHTTP3_INCLUDE_DIR}/nghttp3/version.h" _mira_nghttp3_version_line
            REGEX "^#define NGHTTP3_VERSION \"")
        string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" _mira_nghttp3_version "${_mira_nghttp3_version_line}")
    endif()
    if(MIRA_NGHTTP3_INCLUDE_DIR AND MIRA_NGHTTP3_LIBRARY AND
            _mira_nghttp3_version VERSION_GREATER_EQUAL "1.15.0")
        include("${CMAKE_CURRENT_LIST_DIR}/mira-http3-dependencies.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/miraHttp3Targets.cmake")
        set(Mira_http3_FOUND TRUE)
    endif()
endif()
if("client_http2" IN_LIST _mira_components AND Mira_http2_FOUND AND Mira_tls_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/miraClientHttp2Targets.cmake")
    set(Mira_client_http2_FOUND TRUE)
endif()
if("client_http3" IN_LIST _mira_components AND Mira_http3_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/miraClientHttp3Targets.cmake")
    set(Mira_client_http3_FOUND TRUE)
endif()
foreach(_component IN LISTS _mira_components)
    if(NOT Mira_${_component}_FOUND)
        set(Mira_${_component}_FOUND FALSE)
        if(Mira_FIND_REQUIRED_${_component} OR NOT Mira_FIND_COMPONENTS)
            string(APPEND Mira_NOT_FOUND_MESSAGE
                "Mira component '${_component}' is unavailable (unknown, not built, or missing dependencies). ")
            set(Mira_FOUND FALSE)
        endif()
    endif()
endforeach()
check_required_components(Mira)
unset(_component)
unset(_option)
unset(_mira_components)
unset(_mira_nghttp3_version)
unset(_mira_nghttp3_version_line)
