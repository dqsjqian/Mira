@PACKAGE_INIT@

# Explicit components load only their dependency closure; no components loads all installed modules.
set(MIRA_WITH_TLS @MIRA_ENABLE_TLS@)
set(MIRA_WITH_HTTP2 @MIRA_ENABLE_HTTP2@)
set(MIRA_WITH_HTTP3 @MIRA_ENABLE_HTTP3@)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/miraTargets.cmake")
set(Mira_core_FOUND TRUE)
set(Mira_http_common_FOUND TRUE)
set(Mira_transport_FOUND TRUE)
set(Mira_http_FOUND TRUE)
set(Mira_tls_FOUND FALSE)
set(Mira_http2_FOUND FALSE)
set(Mira_quic_FOUND FALSE)
set(Mira_http3_FOUND FALSE)
set(Mira_FOUND TRUE)
unset(Mira_NOT_FOUND_MESSAGE)

set(_mira_components ${Mira_FIND_COMPONENTS})
if(NOT _mira_components)
    foreach(_component IN ITEMS tls http2 http3)
        string(TOUPPER "${_component}" _option)
        if(MIRA_WITH_${_option})
            list(APPEND _mira_components ${_component})
        endif()
    endforeach()
endif()

# Probe quietly first so missing OPTIONAL_COMPONENTS dependencies do not fail the package.
if("tls" IN_LIST _mira_components AND MIRA_WITH_TLS)
    find_package(OpenSSL 3.0 QUIET COMPONENTS SSL Crypto)
    if(OpenSSL_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/miraTlsTargets.cmake")
        set(Mira_tls_FOUND TRUE)
    endif()
endif()
if("http2" IN_LIST _mira_components AND MIRA_WITH_HTTP2)
    set(_mira_saved_module_path "${CMAKE_MODULE_PATH}")
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_package(NGHTTP2 1.61 QUIET)
    set(CMAKE_MODULE_PATH "${_mira_saved_module_path}")
    unset(_mira_saved_module_path)
    if(NGHTTP2_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/miraHttp2Targets.cmake")
        set(Mira_http2_FOUND TRUE)
    endif()
endif()
if(("quic" IN_LIST _mira_components OR "http3" IN_LIST _mira_components)
        AND MIRA_WITH_HTTP3)
    find_package(OpenSSL 3.5 QUIET COMPONENTS SSL Crypto)
    find_path(MIRA_NGTCP2_INCLUDE_DIR ngtcp2/ngtcp2_crypto_ossl.h)
    find_library(MIRA_NGTCP2_LIBRARY NAMES ngtcp2)
    find_library(MIRA_NGTCP2_OSSL_LIBRARY NAMES ngtcp2_crypto_ossl)
    if(OpenSSL_FOUND AND MIRA_NGTCP2_INCLUDE_DIR AND MIRA_NGTCP2_LIBRARY
            AND MIRA_NGTCP2_OSSL_LIBRARY)
        include("${CMAKE_CURRENT_LIST_DIR}/mira-quic-dependencies.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/miraQuicTargets.cmake")
        set(Mira_quic_FOUND TRUE)
    endif()
endif()
if("http3" IN_LIST _mira_components AND Mira_quic_FOUND)
    find_path(MIRA_NGHTTP3_INCLUDE_DIR nghttp3/nghttp3.h)
    find_library(MIRA_NGHTTP3_LIBRARY NAMES nghttp3)
    if(MIRA_NGHTTP3_INCLUDE_DIR AND MIRA_NGHTTP3_LIBRARY)
        include("${CMAKE_CURRENT_LIST_DIR}/mira-http3-dependencies.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/miraHttp3Targets.cmake")
        set(Mira_http3_FOUND TRUE)
    endif()
endif()
foreach(_component IN LISTS _mira_components)
    if(NOT Mira_${_component}_FOUND)
        set(Mira_${_component}_FOUND FALSE)
        if(Mira_FIND_REQUIRED_${_component} OR NOT Mira_FIND_COMPONENTS)
            string(APPEND Mira_NOT_FOUND_MESSAGE
                "Mira component '${_component}' is unavailable (unknown, not built, or missing dependencies). ")
            set(Mira_FOUND FALSE)
        endif()
    endif()
endforeach()
check_required_components(Mira)
unset(_component)
unset(_option)
unset(_mira_components)
