#pragma once

// Mira/core/version.hpp — generated from the project version in CMake.
//
// Generated rather than hand-written so that the version cannot disagree with
// the one the package config and the installed libraries carry. Editing this
// template does not change the version; change `project(Mira VERSION ...)` instead.
//
// The encoded form exists so that a consumer can compile against two versions
// of Mira:
//
//   #if MIRA_VERSION_MAJOR >= 1
//       // use the newer signature
//   #endif
//
// Breaking source changes increment the major version. Rebuild consumers when
// changing SDKs; the package version does not promise binary ABI compatibility.

#define MIRA_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define MIRA_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define MIRA_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define MIRA_VERSION_STRING "@PROJECT_VERSION@"

/// Pack a version into one comparable integer.
#define MIRA_VERSION_NUMBER(major, minor, patch) \
    ((major) * 10000 + (minor) * 100 + (patch))

#define MIRA_VERSION                                                     \
    MIRA_VERSION_NUMBER(MIRA_VERSION_MAJOR, MIRA_VERSION_MINOR,  \
                            MIRA_VERSION_PATCH)
